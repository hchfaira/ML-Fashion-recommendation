{
  "_description": "Style Rules Configuration — All domain knowledge editable by stylists without code changes",
  "_last_updated": "2026-03-14",

  "seven_point_rule": {
    "_description": "The 7-point rule: harmonious outfits score between min and max optimal points. Basic pieces = 1pt, statement pieces = 2pts.",
    "min_optimal_points": 7,
    "max_optimal_points": 10,
    "optimal_center": 8.5,
    "statement_patterns": [
      "stripes", "plaid", "floral", "geometric", "animal",
      "abstract", "paisley", "polka_dot", "checkered", "leopard",
      "zebra", "tropical", "tie_dye", "camo", "houndstooth"
    ],
    "statement_textures": [
      "velvet", "sequin", "leather", "lace", "fur", "faux_fur",
      "metallic", "satin", "silk", "tweed", "boucle", "crochet",
      "knit_cable", "quilted", "embossed", "pleated"
    ],
    "statement_embellishments": [
      "sequins", "beading", "embroidery", "ruffles", "fringe",
      "studs", "crystals", "pearls", "patches", "applique",
      "cutouts", "lace_trim", "metallic_hardware"
    ],
    "inherently_statement_subcategories": [
      "blazer", "statement_jewelry", "cocktail_dress", "gown",
      "fur_coat", "leather_jacket", "sequin_top", "maxi_dress"
    ],
    "bold_colors": [
      "red", "orange", "yellow", "fuchsia", "magenta", "purple",
      "electric_blue", "lime", "coral", "hot_pink", "neon"
    ]
  },

  "creativity": {
    "_description": "Rules for evaluating outfit creativity — rule-breaking, style fusions, and risk pieces.",
    "scoring_weights": {
      "rule_breaking": 0.30,
      "intentionality": 0.30,
      "novelty": 0.25,
      "risk": 0.15
    },
    "safe_combos": {
      "colors": [
        ["black", "white", "gray"],
        ["navy", "white", "beige"],
        ["monochrome"]
      ],
      "formality": "consistent",
      "patterns": "one_or_none",
      "proportions": "balanced"
    },
    "creative_combos": {
      "color_clashes_that_work": [
        ["pink", "red"],
        ["orange", "pink"],
        ["purple", "green"],
        ["brown", "black"],
        ["navy", "black"]
      ],
      "formality_fusions": [
        ["sneakers", "formal"],
        ["hoodie", "tailored"],
        ["t-shirt", "evening"]
      ],
      "style_fusions": [
        ["sporty", "elegant"],
        ["punk", "preppy"],
        ["bohemian", "minimalist"],
        ["streetwear", "tailored"]
      ]
    },
    "risk_pieces": {
      "patterns": ["animal", "camo", "tie_dye", "abstract", "novelty"],
      "colors": ["neon", "lime", "hot pink", "orange", "yellow"],
      "styles": ["avant-garde", "deconstructed", "oversized", "sheer"],
      "combos": ["multiple patterns", "color blocking", "mixed metals"]
    },
    "style_tribes": {
      "sporty":     ["athletic", "sporty", "activewear", "athleisure"],
      "elegant":    ["elegant", "sophisticated", "refined", "dressy"],
      "punk":       ["punk", "edgy", "grunge", "rock"],
      "preppy":     ["preppy", "classic", "collegiate", "traditional"],
      "bohemian":   ["boho", "bohemian", "hippie", "free-spirited"],
      "minimalist": ["minimal", "minimalist", "clean", "simple"],
      "streetwear": ["street", "urban", "hip-hop", "skate"],
      "romantic":   ["romantic", "feminine", "soft", "delicate"]
    },
    "novel_materials": ["pvc", "latex", "neoprene", "mesh", "vinyl"],
    "novel_patterns":  ["abstract", "tie_dye", "camo", "novelty"],
    "novel_style_tags": [
      "deconstructed", "avant-garde", "experimental",
      "architectural", "sculptural", "transformable"
    ],
    "coherent_rule_break_pairs": [
      ["formality_mix", "style_fusion"],
      ["color_clash",   "pattern_overload"],
      ["volume_extreme","proportion_inversion"]
    ],
    "thresholds": {
      "safe_max_score":       0.20,
      "moderate_max_score":   0.40,
      "creative_max_score":   0.70,
      "intentionality_min_creative":    0.60,
      "intentionality_min_avant_garde": 0.50,
      "fashion_forward_min":  0.50,
      "success_creativity_min": 0.30,
      "success_style_min":    0.60,
      "success_intentionality_min": 0.60,
      "max_intentional_coherence_bonus": 0.15,
      "max_rule_breaking_severity_divisor": 3.0,
      "max_novelty_points": 1.0,
      "max_risk_points": 1.0,
      "novelty_material_score": 0.30,
      "novelty_pattern_score":  0.20,
      "novelty_tag_score":      0.30,
      "risk_pattern_score":     0.25,
      "risk_color_score":       0.20,
      "risk_style_score":       0.30,
      "risk_sheer_score":       0.20
    }
  },

