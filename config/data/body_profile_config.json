    "fit_predictor": {
        "description": "Rules for predicting garment fit based on user measurements",
        "size_match_scores": {
            "exact": 1.0,
            "one_off": 0.7,
            "two_off": 0.4,
            "three_plus_off": 0.1
        },
        "size_order": ["XXS", "XS", "S", "M", "L", "XL", "XXL", "3XL", "4XL"],
        "fit_type_adjustments": {
            "description": "Adjustments based on BMI category and garment fit type",
            "underweight": {
                "oversized": 0.1,
                "regular": 0.0,
                "slim": -0.1
            },
            "normal": {
                "oversized": 0.0,
                "regular": 0.0,
                "slim": 0.0
            },
            "overweight": {
                "oversized": 0.1,
                "regular": 0.0,
                "slim": -0.2
            },
            "obese": {
                "oversized": 0.15,
                "regular": 0.0,
                "slim": -0.3
            }
        }
    },
    
    "proportion_harmonizer": {
